<Window x:Class="PCBuilder.Views.CustomPartWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add a custom part" Width="520" Height="720" WindowStartupLocation="CenterOwner" Background="#F4F7FB"><DockPanel Margin="24"><StackPanel DockPanel.Dock="Top"><TextBlock Text="CUSTOM CATALOG" Foreground="#D97706" FontWeight="Bold"/><TextBlock Text="Add your own component" FontFamily="Georgia" FontWeight="Bold" FontSize="22" Margin="0,8"/><TextBlock Text="Fill in all specifications. Separate list values with commas. Prices are in PKR." TextWrapping="Wrap" Foreground="#64748B"/><ComboBox x:Name="CategoryBox" SelectionChanged="CategoryChanged" Margin="0,15,0,5"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True"/><Button Content="Add to catalog" Background="#D97706" Foreground="White" Click="Save_Click"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Fields"/></ScrollViewer></DockPanel></Window>
