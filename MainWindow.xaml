<Window x:Class="PCBuilder.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PC Builder &amp; Compatibility Checker" Width="1400" Height="850" MinWidth="1050" MinHeight="700" Background="{StaticResource Ice}" FontFamily="Segoe UI">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Background="{StaticResource Slate}" Padding="24,18"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="New build" Command="{Binding NewCommand}"/><Button Content="Load JSON" Command="{Binding LoadCommand}"/><Button Content="Save JSON" Command="{Binding SaveCommand}"/><Button Content="+ Custom part" Background="{StaticResource Amber}" Foreground="White" Command="{Binding CustomCommand}"/></StackPanel><StackPanel><TextBlock Foreground="#FBBF24" FontSize="10" FontWeight="Bold" Text="COMSATS  /  ADVANCED PROGRAMMING LAB"/><TextBlock Foreground="White" FontFamily="Georgia" FontSize="23" FontWeight="Bold" Text="PC Builder &amp; Compatibility Checker"/></StackPanel></DockPanel></Border>
 <Border Grid.Row="1" Background="{Binding StatusColor}" Padding="24,12"><DockPanel><TextBlock DockPanel.Dock="Right" Foreground="White" Text="OFFLINE  •  LOCAL PRICING" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal"><TextBlock Foreground="White" FontFamily="Georgia" FontWeight="Bold" FontSize="17" Text="{Binding Status}"/><TextBlock Foreground="White" Margin="18,3,0,0" Text="{Binding StatusDetail}"/></StackPanel></DockPanel></Border>
 <Grid Grid.Row="2" Margin="24,18"><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="White" CornerRadius="6" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="01 / CATALOG FILTERS" FontWeight="Bold" Foreground="{StaticResource Amber}" FontSize="11"/><TextBlock Text="Find your parts" FontFamily="Georgia" FontSize="21" FontWeight="Bold" Margin="0,8,0,8"/><TextBlock Text="Filter the dropdowns by model, brand, socket or budget. Other categories remain visible when filtering by socket." TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,18"/><TextBlock Text="SEARCH" FontSize="10" FontWeight="Bold"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="BRAND" FontSize="10" FontWeight="Bold"/><TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="SOCKET  (AM4, AM5, LGA1700)" FontSize="10" FontWeight="Bold"/><TextBox Text="{Binding Socket, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="MAX PRICE  /  PKR" FontSize="10" FontWeight="Bold"/><TextBox Text="{Binding Budget, UpdateSourceTrigger=PropertyChanged}"/><Separator Margin="0,16"/><TextBlock Text="HOW IT WORKS" FontWeight="Bold" FontSize="10" Foreground="{StaticResource Amber}"/><TextBlock Text="Choose a component for each slot. Add local prices or create a custom part. Your build is checked as you go." TextWrapping="Wrap" Foreground="#64748B" Margin="0,8,0,0"/></StackPanel></ScrollViewer></Border>
 <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><StackPanel DockPanel.Dock="Right" Width="240"><TextBlock Text="BUILD NAME" FontSize="10" FontWeight="Bold"/><TextBox Text="{Binding BuildName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="02 / YOUR CONFIGURATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Amber}"/><TextBlock Text="Build workbench" FontFamily="Georgia" FontSize="22" FontWeight="Bold" Margin="0,6"/></StackPanel></DockPanel>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Slots}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="125"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="0,0,12,0"><ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected, Mode=TwoWay}" IsSynchronizedWithCurrentItem="False"/><TextBlock Text="{Binding Summary}" Foreground="#64748B" FontSize="11"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="CATALOG" Foreground="#94A3B8" FontSize="9"/><TextBlock Text="{Binding CatalogPrice}" FontFamily="Consolas" Margin="0,7"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="YOUR PRICE / PKR" Foreground="#94A3B8" FontSize="9"/><TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" ToolTip="Blank uses catalog price; enter a non-negative number" FontFamily="Consolas"/><TextBlock Text="{Binding PriceHint}" FontSize="9" Foreground="#D97706"/></StackPanel><Button Grid.Column="4" Content="×" ToolTip="Clear this slot" VerticalAlignment="Center" Click="ClearSlot_Click"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="DIAGNOSTICS" FontWeight="Bold" FontSize="10" Foreground="{StaticResource Amber}"/><ItemsControl ItemsSource="{Binding Diagnostics}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#9A3412" Margin="0,4,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Grid></Border></Grid>
 <Border Grid.Row="3" Background="{StaticResource Slate}" Padding="26,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Foreground="#94A3B8" Text="ESTIMATED POWER" FontSize="10"/><TextBlock Foreground="White" FontFamily="Consolas" FontSize="20" Text="{Binding Estimated}"/><ProgressBar Value="{Binding PowerPercent, Mode=OneWay}" Height="4" Maximum="100" Margin="0,5,30,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Foreground="#94A3B8" Text="RECOMMENDED PSU  /  +30%" FontSize="10"/><TextBlock Foreground="White" FontFamily="Consolas" FontSize="20" Text="{Binding Recommended}"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Foreground="#FBBF24" Text="ESTIMATED TOTAL" FontSize="10"/><TextBlock Foreground="White" FontFamily="Consolas" FontSize="24" FontWeight="Bold" Text="{Binding Total}"/></StackPanel></Grid></Border>
 </Grid></Window>
